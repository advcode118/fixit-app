# FixIt Environment Variables

# GitHub Personal Access Token (required for creating PRs)
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
GITHUB_TOKEN=ghp_your_token_here

# AI Provider API Keys (optional - falls back to deterministic fixes)
# X.AI (Grok) - Primary LLM provider
# Get your API key at: https://x.ai/api
XAI_API_KEY=xai_your_key_here

# OpenAI - Fallback LLM provider
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here
